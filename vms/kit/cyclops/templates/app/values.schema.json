{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "title": "Web app",
  "properties": {
    "image": {"type": "string", "title": "Image", "description": "Container image, with a tag"},
    "replicas": {"type": "integer", "title": "Replicas", "minimum": 1, "maximum": 4},
    "port": {"type": "integer", "title": "Container port"}
  },
  "required": ["image", "replicas"],
  "order": ["image", "replicas", "port"]
}
