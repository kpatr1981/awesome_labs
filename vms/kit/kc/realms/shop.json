{
  "realm": "shop",
  "enabled": true,
  "roles": {"realm": [
    {"name": "orders:read", "description": "may list orders"},
    {"name": "orders:write", "description": "may create orders"}
  ]},
  "groups": [{"name": "ops"}, {"name": "sales"}],
  "users": [
    {"username": "alice", "enabled": true, "email": "alice@example.com", "emailVerified": true, "firstName": "Alice", "lastName": "Admin",
     "credentials": [{"type": "password", "value": "Alice-pass-1", "temporary": false}], "groups": ["/ops"]},
    {"username": "bob", "enabled": true, "email": "bob@example.com", "emailVerified": true, "firstName": "Bob", "lastName": "Buyer",
     "credentials": [{"type": "password", "value": "Bob-pass-1", "temporary": false}], "groups": ["/sales"]},
    {"username": "carol", "enabled": true, "email": "carol@example.com", "emailVerified": true, "firstName": "Carol", "lastName": "Clerk",
     "credentials": [{"type": "password", "value": "Carol-pass-1", "temporary": false}], "groups": ["/sales"]}
  ],
  "clients": [
    {"clientId": "orders-web", "name": "Orders web app", "enabled": true, "publicClient": false, "secret": "orders-web-secret",
     "standardFlowEnabled": true, "directAccessGrantsEnabled": true, "serviceAccountsEnabled": false,
     "redirectUris": ["http://127.0.0.1:4180/oauth2/callback"], "webOrigins": ["+"],
     "protocolMappers": [{"name": "orders-api audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
       "config": {"included.client.audience": "orders-api", "access.token.claim": "true", "id.token.claim": "false", "introspection.token.claim": "true"}}]},
    {"clientId": "billing-web", "name": "Billing web app", "enabled": true, "publicClient": false, "secret": "billing-web-secret",
     "standardFlowEnabled": true, "directAccessGrantsEnabled": true, "serviceAccountsEnabled": false,
     "redirectUris": ["http://127.0.0.1:4181/oauth2/callback"]},
    {"clientId": "orders-api", "name": "Orders API", "enabled": true, "publicClient": false, "secret": "orders-api-secret",
     "standardFlowEnabled": false, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false}
  ]
}
