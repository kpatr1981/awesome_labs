{
  "realm": "acme",
  "enabled": true,
  "accessTokenLifespan": 300,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "permanentLockout": false,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "passwordPolicy": "length(12) and notUsername",
  "roles": {"realm": [{"name": "deploy:read"}, {"name": "deploy:write"}]},
  "groups": [
    {"name": "ops", "realmRoles": ["deploy:read", "deploy:write"]},
    {"name": "dev", "realmRoles": ["deploy:read"]}
  ],
  "users": [
    {"username": "ana", "enabled": true, "email": "ana@acme.example", "emailVerified": true, "firstName": "Ana", "lastName": "Ortiz",
     "credentials": [{"type": "password", "value": "Ana-pass-2026!", "temporary": false}], "groups": ["/ops"]},
    {"username": "ben", "enabled": true, "email": "ben@acme.example", "emailVerified": true, "firstName": "Ben", "lastName": "Okafor",
     "credentials": [{"type": "password", "value": "Ben-pass-2026!", "temporary": false}], "groups": ["/dev"]},
    {"username": "cleo", "enabled": true, "email": "cleo@acme.example", "emailVerified": true, "firstName": "Cleo", "lastName": "Park",
     "credentials": [{"type": "password", "value": "Cleo-pass-2026!", "temporary": false}]}
  ],
  "clients": [
    {"clientId": "deploy-web", "enabled": true, "publicClient": false, "secret": "deploy-web-secret-2026",
     "standardFlowEnabled": true, "directAccessGrantsEnabled": false, "serviceAccountsEnabled": false,
     "redirectUris": ["http://127.0.0.1:4180/oauth2/callback"],
     "protocolMappers": [{"name": "groups", "protocol": "openid-connect", "protocolMapper": "oidc-group-membership-mapper",
       "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "access.token.claim": "true", "userinfo.token.claim": "true"}}]},
    {"clientId": "deploy-cli", "enabled": true, "publicClient": true, "standardFlowEnabled": false, "directAccessGrantsEnabled": true,
     "protocolMappers": [{"name": "deploy-api audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper",
       "config": {"included.client.audience": "deploy-api", "access.token.claim": "true"}}]},
    {"clientId": "deploy-api", "enabled": true, "publicClient": false, "standardFlowEnabled": false, "directAccessGrantsEnabled": false,
     "serviceAccountsEnabled": false, "implicitFlowEnabled": false}
  ]
}
